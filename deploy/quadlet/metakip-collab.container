[Unit]
Description=Metakip Collaboration Server (Hocuspocus)
After=metakip-api.service metakip-postgres.service
Requires=metakip-api.service metakip-postgres.service

[Container]
Image=localhost/metakip-collab:latest
ContainerName=metakip-collab
Pod=metakip.pod
Environment=NODE_ENV=production
Environment=COLLAB_PORT=1234
EnvironmentFile=/var/www/metakip/.env
WorkingDir=/app
Exec=node /app/packages/collab/dist/index.js

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
