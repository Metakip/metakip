[Unit]
Description=Metakip PostgreSQL Database
After=network-online.target

[Container]
Image=docker.io/library/postgres:17-alpine
ContainerName=metakip-postgres
Pod=metakip.pod
EnvironmentFile=/var/www/metakip/.env
Volume=postgres-data:/var/lib/postgresql/data:Z
HealthCmd=CMD-SHELL pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
