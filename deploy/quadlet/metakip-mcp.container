[Unit]
Description=Metakip MCP Server
After=network-online.target metakip-api.service
Requires=metakip-api.service

[Container]
Image=localhost/metakip-mcp:latest
ContainerName=metakip-mcp
Pod=metakip.pod
Environment=NODE_ENV=production
Environment=MCP_PORT=3002
EnvironmentFile=/var/www/metakip/.env
WorkingDir=/app
Exec=node /app/packages/mcp/dist/index.js

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
