<starlight-theme-toggle>
  <button type="button" aria-label="Toggle theme" title="Toggle theme">
    <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
    </svg>
    <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8" />
    </svg>
    <svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="4" width="18" height="12" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8" />
      <path d="M8 20h8M12 16v4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
    </svg>
  </button>
</starlight-theme-toggle>

<style>
  starlight-theme-toggle {
    display: inline-flex;
  }

  button {
    position: relative;
    display: flex;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 0;
    border-radius: 0.375rem;
    color: #52525b;
    background: transparent;
    cursor: pointer;
  }

  button:hover {
    background: #e4e4e7;
  }

  :global(.dark) button {
    color: #d4d4d8;
  }

  :global(.dark) button:hover {
    background: #27272a;
  }

  .theme-icon {
    position: absolute;
    width: 1.125rem;
    height: 1.125rem;
    transition: opacity 300ms ease, transform 300ms ease;
  }

  .theme-icon-light,
  .theme-icon-dark,
  .theme-icon-system {
    opacity: 0;
    transform: scale(0.5) rotate(90deg);
  }

  starlight-theme-toggle[data-theme='light'] .theme-icon-light,
  starlight-theme-toggle[data-theme='dark'] .theme-icon-dark,
  starlight-theme-toggle[data-theme='system'] .theme-icon-system {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
</style>

<script>
  type Theme = 'system' | 'dark' | 'light';
  type ThemeProvider = { apply: (theme: Theme) => void };
  const getProvider = (): ThemeProvider | undefined =>
    (window as Window & { MetakipThemeProvider?: ThemeProvider }).MetakipThemeProvider;
  const labels: Record<Theme, string> = {
    light: 'Switch to dark theme',
    dark: 'Switch to system theme',
    system: 'Switch to light theme',
  };
  const getTheme = (): Theme => {
    const value = localStorage.getItem('metakip-theme');
    return value === 'dark' || value === 'light' || value === 'system' ? value : 'system';
  };
  const update = (theme: Theme): void => {
    getProvider()?.apply(theme);
    document.querySelectorAll('starlight-theme-toggle').forEach((toggle) => {
      toggle.setAttribute('data-theme', theme);
      const button = toggle.querySelector('button');
      if (button instanceof HTMLButtonElement) button.title = labels[theme];
    });
  };
  const next = (theme: Theme): Theme => (theme === 'light' ? 'dark' : theme === 'dark' ? 'system' : 'light');
  class StarlightThemeToggle extends HTMLElement {
    connectedCallback(): void {
      const button = this.querySelector('button');
      if (!button) return;
      update(getTheme());
      button.addEventListener('click', () => update(next(getTheme())));
    }
  }
  customElements.define('starlight-theme-toggle', StarlightThemeToggle);
</script>
