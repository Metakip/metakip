<script is:inline>
  window.MetakipThemeProvider = (() => {
    const key = 'metakip-theme';
    const getStoredTheme = () => {
      const value = localStorage.getItem(key);
      return value === 'light' || value === 'dark' || value === 'system' ? value : 'system';
    };
    const isDark = (theme) =>
      theme === 'dark' ||
      (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    const apply = (theme) => {
      const dark = isDark(theme);
      document.documentElement.classList.toggle('dark', dark);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      localStorage.setItem(key, theme);
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#09090b' : '#ffffff');
      document.querySelectorAll('starlight-theme-toggle').forEach((toggle) => {
        toggle.setAttribute('data-theme', theme);
      });
    };
    const controller = { apply, getTheme: getStoredTheme };
    apply(getStoredTheme());
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (getStoredTheme() === 'system') apply('system');
    });
    return controller;
  })();
</script>
