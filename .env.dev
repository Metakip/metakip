# PostgreSQL (local container)
# IMPORTANT: DATABASE_URL must use the same credentials as POSTGRES_* below.
# If you change any POSTGRES_* value, update DATABASE_URL to match.
POSTGRES_USER=metakip
POSTGRES_PASSWORD=password
POSTGRES_DB=metakip
DATABASE_URL=postgresql://metakip:password@localhost:5432/metakip

# Better Auth
BETTER_AUTH_SECRET=your-secret-here-min-32-chars
# Development-only value. Generate a unique value for every non-development environment.
COLLAB_INTERNAL_SECRET=development-only-collaboration-secret-0123456789abcdef
MCP_API_INTERNAL_SECRET=development-only-mcp-api-secret-0123456789abcdef

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App
FRONTEND_URL=http://localhost:5173
BETTER_AUTH_ISSUER=http://localhost:5173/api/auth
BETTER_AUTH_JWKS_URL=http://127.0.0.1:3001/api/auth/jwks
MCP_PUBLIC_URL=http://localhost:3002
PORT=3001
MCP_PORT=3002
MCP_API_URL=http://127.0.0.1:3001
COLLAB_PORT=1234

# CORS — comma-separated list of allowed origins (production only)
# Example: CORS_ORIGINS=https://app.yourdomain.com
CORS_ORIGINS=

# Environment
NODE_ENV=development

# Optional in development. When omitted, uploads use packages/api/uploads.
UPLOAD_STORAGE=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Frontend (Vite - must have VITE_ prefix)
VITE_API_URL=http://localhost:3001
# Collaboration uses the same-origin /collab route proxied by Vite or Caddy.
