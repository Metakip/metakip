# Production environment variables for app.metakip.com
# Place this file at /var/www/metakip/.env on your VPS

# PostgreSQL (local container)
# IMPORTANT: DATABASE_URL must use the same credentials as POSTGRES_* below.
# If you change any POSTGRES_* value, update DATABASE_URL to match.
POSTGRES_USER=metakip
POSTGRES_PASSWORD=replace-with-secure-password
POSTGRES_DB=metakip
DATABASE_URL=postgresql://metakip:replace-with-secure-password@localhost:5432/metakip

# Better Auth
BETTER_AUTH_SECRET=replace-with-32-char-secret-minimum
# Generated by deploy/setup.sh; retain the generated value on later deploys.

# OAuth — Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth — GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# App
FRONTEND_URL=https://app.metakip.com
BETTER_AUTH_JWKS_URL=http://127.0.0.1:3001/api/auth/jwks
MCP_PUBLIC_URL=https://mcp.metakip.com
PORT=3001
MCP_PORT=3002
MCP_API_URL=http://127.0.0.1:3001
COLLAB_PORT=1234

# CORS — must match your frontend domain
CORS_ORIGINS=https://app.metakip.com

# Environment
NODE_ENV=production

# Frontend env vars (baked at build time)
VITE_API_URL=https://app.metakip.com
# Collaboration uses the same-origin /collab route proxied by Caddy.
