{
  "name": "@metakip/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include 'src/**/*.ts' --conditions=development src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --tsconfig tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/core": "^1.7.2",
    "@better-auth/mcp": "^1.7.2",
    "@hono/node-server": "^1.19.9",
    "@metakip/shared": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-auth": "^1.7.2",
    "better-call": "1.4.0",
    "dotenv": "^17.3.1",
    "hono": "^4.12.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
