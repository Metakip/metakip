{
  "name": "Metakip",
  "short_name": "Metakip",
  "description": "A collaborative workspace for your notes and ideas.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "icons": [
    {
      "src": "/icon-light-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-light-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Page",
      "short_name": "New Page",
      "description": "Create a page in your workspace.",
      "url": "/?action=new-page",
      "icons": [
        {
          "src": "/shortcut-icons/new-page.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Search your workspace.",
      "url": "/?action=search",
      "icons": [
        {
          "src": "/shortcut-icons/search.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Documentation",
      "short_name": "Documentation",
      "description": "Read the Metakip documentation.",
      "url": "/documentation",
      "icons": [
        {
          "src": "/shortcut-icons/documentation.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
