---
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import { Image } from 'astro:assets';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import brandMark from '../assets/metakip-mark.png';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import { SITE_NAVIGATION } from '../data/siteConfig';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import AppLink from './AppLink.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
// biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
const isHome = currentPath === '/';
---

<header class:list={['site-header', isHome ? 'home' : 'page']} transition:persist="site-navigation" transition:animate="none">
  <div class="site-header-inner">
    <nav class="page-nav" aria-label="Page navigation">
      <a
        class:list={['site-brand', isHome && 'active']}
        href="/"
        data-astro-prefetch="load"
        aria-current={isHome ? 'page' : undefined}
        aria-label="Metakip home"
      >
        <Image class="site-brand-mark" src={brandMark} width={20} height={18} alt="" format="webp" quality={100} loading="eager" />
        <span>Metakip</span>
      </a>
      {SITE_NAVIGATION.map((link) => (
        <a
          class:list={['header-feature-link', link.href === currentPath && 'active']}
          href={link.href}
          data-astro-prefetch="load"
          aria-current={link.href === currentPath ? 'page' : undefined}
        >{link.label}</a>
      ))}
      <AppLink class="header-login-link">Log In</AppLink>
    </nav>
  </div>
</header>

<script>
  const pageOrder = ['/', '/use-cases', '/pricing'];
  const getPageOrder = (pathname: string): number => {
    const normalizedPath = pathname.replace(/\/$/, '') || '/';
    return pageOrder.indexOf(normalizedPath);
  };

  document.addEventListener('astro:before-preparation', (event) => {
    const fromOrder = getPageOrder(event.from.pathname);
    const toOrder = getPageOrder(event.to.pathname);
    if (fromOrder < 0 || toOrder < 0 || fromOrder === toOrder) return;

    event.direction = toOrder < fromOrder ? 'back' : 'forward';
  });

  // Navigation stays mounted; update the current page after every content swap.
  const updateNavigation = (): void => {
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    const header = document.querySelector<HTMLElement>('.site-header');
    header?.classList.toggle('home', currentPath === '/');
    header?.classList.toggle('page', currentPath !== '/');
    document.querySelectorAll<HTMLAnchorElement>('.page-nav a').forEach((link) => {
      const url = new URL(link.href);
      const active =
        url.origin === window.location.origin &&
        url.pathname === currentPath &&
        (url.hash ? url.hash === window.location.hash : !window.location.hash);
      link.classList.toggle('active', active);
      if (active) link.setAttribute('aria-current', url.hash ? 'location' : 'page');
      else link.removeAttribute('aria-current');
    });
  };
  document.addEventListener('astro:page-load', updateNavigation);
  window.addEventListener('hashchange', updateNavigation);
</script>

<style>
  .site-header {
    position: sticky;
    top: 1rem;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    width: calc(100% - 2rem);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .site-header::-webkit-scrollbar { display: none; }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .site-header.home {
    margin: 1rem auto -3.25rem;
    width: calc(100% - 2rem);
  }

  .site-header.page {
    margin: 1rem auto 0;
  }

  .page-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
    padding: 0.25rem;
    border: 1px solid var(--line, #e5e5e5);
    border-radius: 999px;
    background: color-mix(in srgb, var(--background, #fff) 92%, var(--text, #111));
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 6%);
  }

  :global(:root:not(.dark)) .page-nav {
    border-color: #d4d4d8;
    background: #f4f4f5;
    box-shadow: 0 0.5rem 1.5rem rgb(24 24 27 / 8%);
  }

  .site-brand,
  .header-feature-link {
    display: inline-flex;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: var(--muted, #52525b);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-brand {
    gap: 0.4rem;
    padding: 0 0.75rem;
  }

  .site-brand-mark {
    display: block;
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    object-fit: contain;
  }

  :global(.dark) .site-brand-mark { filter: invert(1); }

  .header-feature-link { padding: 0 0.75rem; }

  :global(.header-login-link) {
    display: inline-flex;
    height: 28px;
    align-items: center;
    justify-content: center;
    margin-left: 0.25rem;
    padding: 0 0.875rem;
    border: 1px solid var(--text);
    border-radius: 999px;
    background: var(--text);
    color: var(--background);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  :global(.header-login-link:hover) {
    background: var(--accent-hover);
    color: var(--background);
  }

  :global(:root:not(.dark)) .site-brand,
  :global(:root:not(.dark)) .header-feature-link {
    color: #52525b;
  }

  .site-brand:hover,
  .header-feature-link:hover,
  .site-brand.active,
  .header-feature-link.active,
  .site-brand.active:hover,
  .header-feature-link.active:hover {
    background: #e4e4e7;
    color: #18181b;
  }

  :global(.dark) .site-brand,
  :global(.dark) .header-feature-link {
    color: #d4d4d8;
  }

  :global(.dark) .site-brand:hover,
  :global(.dark) .header-feature-link:hover,
  :global(.dark) .site-brand.active,
  :global(.dark) .header-feature-link.active,
  :global(.dark) .site-brand.active:hover,
  :global(.dark) .header-feature-link.active:hover {
    background: #3f3f46;
    color: #fafafa;
  }

  .site-header a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 560px) {
    .site-header { justify-content: flex-start; }
    .site-header-inner {
      width: max-content;
      min-width: 100%;
      flex: 0 0 auto;
      justify-content: center;
    }
  }
</style>
