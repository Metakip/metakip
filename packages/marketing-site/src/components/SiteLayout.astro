---
import '../styles/fonts.css';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import { ClientRouter, slide } from 'astro:transitions';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import appleTouchIcon from '../../../shared/assets/app-favicon/apple-touch-icon.png';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import darkIcon192 from '../../../shared/assets/app-favicon/icon-dark-192.png';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import darkIcon512 from '../../../shared/assets/app-favicon/icon-dark-512.png';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import lightIcon192 from '../../../shared/assets/app-favicon/icon-light-192.png';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import lightIcon512 from '../../../shared/assets/app-favicon/icon-light-512.png';
import { SITE_ORIGIN } from '../data/siteConfig';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import SiteFooter from './SiteFooter.astro';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import SiteHeader from './SiteHeader.astro';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import ThemeController from './ThemeController.astro';

interface Props {
  title: string;
  description: string;
  url: string;
  markdownUrl?: string;
  describedBy?: string;
  structuredData?: Record<string, unknown>;
  noIndex?: boolean;
}

const {
  // biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
  title,
  // biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
  description,
  // biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
  url,
  // biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
  markdownUrl,
  // biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
  describedBy = `${SITE_ORIGIN}/llms.txt`,
  structuredData,
  // biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
  noIndex = false,
} = Astro.props;
const serializeStructuredData = (data: Record<string, unknown>): string => {
  const serialized = JSON.stringify(data);
  if (serialized === undefined) throw new Error('Structured data could not be serialized');
  return serialized.replaceAll('<', '\\u003c');
};
// biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
const structuredDataJson = structuredData ? serializeStructuredData(structuredData) : undefined;
---

<!doctype html>
<html lang="en" transition:animate="none">
    <head>
        <ClientRouter fallback="swap" />
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#ffffff" />
        <meta name="description" content={description} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={url} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Metakip" />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {noIndex && <meta name="robots" content="noindex, nofollow" />}
        <link rel="canonical" href={url} />
        {markdownUrl && (
            <link rel="alternate" type="text/markdown" href={markdownUrl} />
        )}
        {describedBy && (
            <link rel="describedby" type="text/plain" href={describedBy} />
        )}
        <link
            rel="icon"
            type="image/png"
            sizes="192x192"
            href={lightIcon192.src}
            data-theme-icon="192"
            data-theme-icon-light={lightIcon192.src}
            data-theme-icon-dark={darkIcon192.src}
        />
        <link
            rel="icon"
            type="image/png"
            sizes="512x512"
            href={lightIcon512.src}
            data-theme-icon="512"
            data-theme-icon-light={lightIcon512.src}
            data-theme-icon-dark={darkIcon512.src}
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href={appleTouchIcon.src}
        />
        <link
            rel="preload"
            href="/fonts/Geist.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <title>{title}</title>
        {structuredDataJson && (
            <script
                is:inline
                type="application/ld+json"
                set:html={structuredDataJson}
            ></script>
        )}
        <ThemeController />
        <slot name="styles" />
    </head>
    <body class:list={[Astro.url.pathname === "/" && "home-page"]}>
        <div class="site-layout-body">
            <SiteHeader />
            <div
                class="site-layout-main"
                transition:name="page-content"
                transition:animate={slide({ duration: "240ms" })}
            >
                <slot />
            </div>
        </div>
        <SiteFooter />
    </body>
</html>

<style is:global>
    :root {
        color-scheme: light;
        font-family: Geist, ui-sans-serif, system-ui, sans-serif;
        /* Change these tokens to update the site's accent palette in one place. */
        --accent: var(--text);
        --accent-hover: color-mix(in srgb, var(--text) 85%, var(--background));
        --accent-text: var(--text);
        --accent-fold: var(--muted);
        --background: #ffffff;
        --text: #000000;
        --muted: #666666;
        --line: #e5e5e5;
        background: var(--background);
        color: var(--text);
    }

    :root.dark {
        color-scheme: dark;
        --background: #090909;
        --text: #f5f5f5;
        --muted: #aaaaaa;
        --line: #292929;
        background: var(--background);
        color: var(--text);
    }

    html {
        min-width: 320px;
    }

    html,
    body {
        min-width: 320px;
        min-height: 100%;
        margin: 0;
    }

    body {
        min-height: 100vh;
        background: var(--background);
        color: var(--text);
    }

    html.theme-transitioning,
    html.theme-transitioning body,
    html.theme-transitioning body *,
    html.theme-transitioning body *::before,
    html.theme-transitioning body *::after {
        transition-property: background-color, color, border-color, outline-color, fill, stroke;
        transition-duration: 220ms;
        transition-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
    }

    .site-layout-body {
        display: block;
        min-height: 100vh;
    }

    .site-layout-main {
        min-width: 0;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    a {
        color: inherit;
        text-underline-offset: 0.2em;
    }

    a:focus-visible,
    button:focus-visible {
        outline: 2px solid var(--muted, #a1a1a1);
        outline-offset: 3px;
    }
</style>
