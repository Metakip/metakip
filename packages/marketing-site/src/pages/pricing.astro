---
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import MarketingContentPage from '../components/MarketingContentPage.astro';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import SiteLayout from '../components/SiteLayout.astro';
import '../styles/marketingPage.css';
import { PRICING_PAGE } from '../data/pricing';
import { SITE_ORIGIN } from '../data/siteConfig';

const PAGE_URL = `${SITE_ORIGIN}/pricing`;
const PAGE_TITLE = 'Pricing | Metakip';
const PAGE_DESCRIPTION = PRICING_PAGE.description;
// biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
const STRUCTURED_DATA = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${PAGE_URL}#webpage`,
      url: PAGE_URL,
      name: PAGE_TITLE,
      description: PAGE_DESCRIPTION,
      isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN },
        { '@type': 'ListItem', position: 2, name: 'Pricing', item: PAGE_URL },
      ],
    },
  ],
};
---

<SiteLayout
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  url={PAGE_URL}
  markdownUrl={`${PAGE_URL}.md`}
  structuredData={STRUCTURED_DATA}
>
  <MarketingContentPage page={PRICING_PAGE} />
</SiteLayout>
