---
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import { Image } from 'astro:assets';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import heroImage from '../assets/metakip-hero.png';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import heroLightImage from '../assets/metakip-hero-light.png';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import AppLink from '../components/AppLink.astro';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import FeatureSection from '../components/FeatureSection.astro';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import SiteLayout from '../components/SiteLayout.astro';
import '../styles/marketingPage.css';
import * as content from '../data/features';
import {
  PRODUCT_APPLICATION,
  PRODUCT_ORGANIZATION,
  PRODUCT_SUMMARY,
  PRODUCT_WEBSITE,
} from '../data/product';
import * as siteConfig from '../data/siteConfig';

const PAGE_URL = `${siteConfig.SITE_ORIGIN}/features`;
const PAGE_TITLE = 'Features | Metakip';
const PAGE_DESCRIPTION =
  'A collaborative knowledge base for humans and agents. Write, organize, and share knowledge in the browser, then let terminals and AI agents work with the same pages through the CLI and API.';
// biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
const STRUCTURED_DATA = {
  '@context': 'https://schema.org',
  '@graph': [
    PRODUCT_ORGANIZATION,
    PRODUCT_WEBSITE,
    {
      '@type': 'WebPage',
      '@id': `${PAGE_URL}#webpage`,
      url: PAGE_URL,
      name: PAGE_TITLE,
      description: PAGE_DESCRIPTION,
      isPartOf: { '@id': `${siteConfig.SITE_ORIGIN}/#website` },
      about: { '@id': `${siteConfig.SITE_ORIGIN}/#application` },
      breadcrumb: { '@id': `${PAGE_URL}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${PAGE_URL}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.SITE_ORIGIN },
        { '@type': 'ListItem', position: 2, name: 'Features', item: PAGE_URL },
      ],
    },
    {
      ...PRODUCT_APPLICATION,
      description: PRODUCT_SUMMARY,
      featureList: content.FEATURE_GROUPS.map(({ title }) => title),
    },
  ],
};
---

<SiteLayout
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  url={PAGE_URL}
  markdownUrl={`${siteConfig.SITE_ORIGIN}/features.md`}
  structuredData={STRUCTURED_DATA}
>
    <style slot="styles">
      .reading-width {
        width: min(42rem, calc(100% - 2.5rem));
        margin: 0 auto;
      }

      .feature-content {
        width: min(72rem, calc(100% - 2.5rem));
        margin: 0 auto;
      }

      .inline-link:hover {
        color: var(--text);
      }

      .page {
        padding: 3.5rem 0 6rem;
      }

      .feature-hero {
        display: grid;
        width: min(72rem, calc(100% - 2.5rem));
        grid-template-columns: 1fr;
        align-items: start;
        gap: 3rem;
        margin: 0 auto 5rem;
      }

      .feature-hero-copy {
        min-width: 0;
        max-width: 48rem;
        margin: 0 auto;
        text-align: center;
      }

      .feature-hero-copy h1,
      .feature-hero-copy .lede {
        margin-right: auto;
        margin-left: auto;
      }

      .feature-hero-visual {
        width: 100%;
        margin: 0;
      }

      .feature-hero-visual img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 0;
        box-shadow: none;
      }

      .feature-hero-visual .hero-image-light {
        border: 1px solid #18181b;
      }

      .feature-hero-visual .hero-image-dark {
        border: 1px solid #ffffff;
      }

      .feature-hero-visual .hero-image-dark {
        display: none;
      }

      :global(.dark) .feature-hero-visual .hero-image-light {
        display: none;
      }

      :global(.dark) .feature-hero-visual .hero-image-dark {
        display: block;
      }

      .lede {
        max-width: 48rem;
      }

      .questions {
        padding: 4rem 0 0;
      }

      .questions h2 {
        margin: 0 0 2rem;
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.04em;
      }

      .question {
        padding: 1.25rem 0;
      }

      .question dt {
        font-size: 0.875rem;
        font-weight: 600;
      }

      .question dd {
        max-width: 36rem;
        margin: 0.5rem 0 0;
        color: var(--muted);
        font-size: 0.875rem;
        line-height: 1.75;
      }

      .closing {
        margin: 4rem 0 0;
        padding-top: 1.5rem;
      }

      @media (max-width: 560px) {
        .reading-width {
          width: min(100% - 2rem, 42rem);
        }

        .feature-content {
          width: min(100% - 2rem, 72rem);
        }

        .feature-hero {
          width: min(100% - 2rem, 42rem);
          grid-template-columns: 1fr;
          gap: 2.5rem;
          margin-bottom: 4rem;
        }

        .page {
          padding-top: 2.5rem;
        }
      }
    </style>
    <main class="page marketing-page">
      <article>
        <header class="feature-hero">
          <div class="feature-hero-copy">
            <h1>The collaborative knowledge base for humans and agents.</h1>
            <p class="lede marketing-lede">{PRODUCT_SUMMARY}</p>
          </div>
          <figure class="feature-hero-visual">
            <Image
              class="hero-image-light"
              src={heroLightImage}
              alt="A Metakip page open in the editor with properties, tags, links, and markdown content."
              width={1196}
              height={949}
              loading="eager"
              decoding="async"
            />
            <Image
              class="hero-image-dark"
              src={heroImage}
              alt="A Metakip page open in the editor with properties, tags, links, and markdown content in dark mode."
              width={1196}
              height={949}
              loading="lazy"
              decoding="async"
            />
          </figure>
        </header>

        <div class="feature-content">
          {content.FEATURE_GROUPS.map((feature) => <FeatureSection feature={feature} />)}

        <section class="questions" aria-labelledby="questions-heading">
          <h2 id="questions-heading">Before you start.</h2>
          <dl>
            {content.FAQS.map(({ question, answer }) => (
              <div class="question">
                <dt>{question}</dt>
                <dd>{answer}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="closing marketing-closing" aria-label="Next step">
          <p>Start in the browser. Add the CLI when you want a terminal in the loop.</p>
          <p><AppLink class="inline-link">Open Metakip</AppLink> or <a class="inline-link" href={`${siteConfig.DOCS_ORIGIN}/agents/metakip-cli/`} target="_blank" rel="noopener noreferrer">Read The CLI Guide</a>.</p>
          <p><a class="inline-link" href="/use-cases">See Who Metakip Is For</a>.</p>
        </section>
        </div>
      </article>
    </main>

</SiteLayout>
