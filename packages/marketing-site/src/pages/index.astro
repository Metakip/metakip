---
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import AppLink from '../components/AppLink.astro';
// biome-ignore lint/correctness/noUnusedImports: Used by the Astro template below.
import SiteLayout from '../components/SiteLayout.astro';
import { FEATURE_GROUPS } from '../data/features';
import {
  PRODUCT_APPLICATION,
  PRODUCT_ORGANIZATION,
  PRODUCT_SUMMARY,
  PRODUCT_WEBSITE,
} from '../data/product';
import { DOCS_ORIGIN, SITE_ORIGIN } from '../data/siteConfig';

// biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
const CLI_GUIDE = `${DOCS_ORIGIN}/agents/markdawn-cli/`;
// biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
const MCP_GUIDE = `${DOCS_ORIGIN}/agents/mcp/`;
// biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
const INSTALL_COMMANDS = [
  {
    label: 'Linux / macOS',
    command: `curl -fsSL ${SITE_ORIGIN}/install.sh | sh`,
    ariaLabel: 'Copy Linux and macOS install command',
  },
  {
    label: 'Windows',
    command: `irm ${SITE_ORIGIN}/install.ps1 | iex`,
    ariaLabel: 'Copy Windows install command',
  },
];
const PAGE_DESCRIPTION =
  'A shared knowledge base for humans and agents. The same information exposed through the browser, MCP, CLI, or API.';
// biome-ignore lint/correctness/noUnusedVariables: Used by the Astro template below.
const STRUCTURED_DATA = {
  '@context': 'https://schema.org',
  '@graph': [
    PRODUCT_ORGANIZATION,
    PRODUCT_WEBSITE,
    {
      '@type': 'WebPage',
      '@id': `${SITE_ORIGIN}/#webpage`,
      url: SITE_ORIGIN,
      name: 'Markdawn',
      description: PAGE_DESCRIPTION,
      isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
      about: { '@id': `${SITE_ORIGIN}/#application` },
    },
    {
      ...PRODUCT_APPLICATION,
      description: PRODUCT_SUMMARY,
      featureList: FEATURE_GROUPS.map(({ title }) => title),
    },
  ],
};
---

<SiteLayout
  title="Markdawn"
  description={PAGE_DESCRIPTION}
  url={SITE_ORIGIN}
  structuredData={STRUCTURED_DATA}
>
    <style slot="styles">
      body {
        overflow-x: hidden;
      }

      body,
      a,
      button {
        transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease;
      }

      a,
      button {
        -webkit-tap-highlight-color: transparent;
      }

      .page-shell {
        position: relative;
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: var(--background);
        color: var(--text);
      }

      .page-shell::before {
        position: absolute;
        inset: 0;
        z-index: 0;
        background: linear-gradient(to bottom, transparent, rgb(244 244 245 / 50%));
        content: '';
        pointer-events: none;
      }

      :global(.dark) .page-shell::before {
        display: none;
      }

      .dawn-glow {
        position: absolute;
        top: -400px;
        left: 50%;
        z-index: 0;
        width: 800px;
        height: 800px;
        transform: translateX(-50%);
        pointer-events: none;
      }

      .dawn-glow::before {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(to bottom, #f43f5e, #fb923c, #fcd34d);
        box-shadow: 0 0 120px rgb(245 158 11 / 40%);
        content: '';
        filter: blur(12px);
        animation: dawn-pulse 15s ease-in-out infinite alternate;
      }

      .dawn-glow::after {
        position: absolute;
        inset: 12.5%;
        border-radius: 999px;
        background: radial-gradient(
          circle,
          rgb(254 240 138 / 38%),
          rgb(251 146 60 / 16%) 48%,
          transparent 72%
        );
        content: '';
        animation: dawn-pulse 15s ease-in-out infinite alternate;
      }

      :global(.dark) .dawn-glow::before {
        background: linear-gradient(to bottom, #881337, #9a3412, #b45309);
        box-shadow: 0 0 120px rgb(234 88 12 / 20%);
      }

      :global(.dark) .dawn-glow::after {
        background: radial-gradient(
          circle,
          rgb(251 191 36 / 16%),
          rgb(234 88 12 / 8%) 48%,
          transparent 72%
        );
      }

      .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 10;
        max-width: 48rem;
        margin: 0 auto;
        padding: 1.5rem;
        text-align: center;
        animation: fade-in 150ms ease-out;
      }

      .beta-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
        padding: 0.25rem 0.75rem;
        border: 1px solid #e4e4e7;
        border-radius: 999px;
        background: #f4f4f5;
        box-shadow: 0 1px 2px rgb(24 24 27 / 5%);
        color: #52525b;
        font-size: 0.875rem;
      }

      :global(.dark) .beta-badge {
        border-color: #27272a;
        background: #18181b;
        color: #a1a1aa;
      }

      .status-dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 999px;
        background: #22c55e;
      }

      h1 {
        margin: 0 0 1.5rem;
        color: #18181b;
        font-size: clamp(3rem, 8vw, 4.5rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1.1;
      }

      :global(.dark) h1 {
        color: #fff;
      }

      .hero-copy {
        max-width: 42rem;
        margin: 0 auto 2.5rem;
        color: #52525b;
        font-size: clamp(1.125rem, 2.5vw, 1.25rem);
        font-weight: 500;
        line-height: 1.625;
      }

      :global(.dark) .hero-copy {
        color: #a1a1aa;
      }

      .actions {
        display: flex;
        width: 100%;
        flex-direction: column;
        gap: 1rem;
      }

      :global(.action-button) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e4e4e7;
        border-radius: 999px;
        background: #fff;
        box-shadow: 0 1px 2px rgb(24 24 27 / 5%);
        color: #3f3f46;
        cursor: pointer;
        font-size: 0.875rem;
        font-weight: 600;
        padding: 0.875rem 2rem;
        text-decoration: none;
      }

      :global(.action-button:hover) {
        background: #f4f4f5;
        box-shadow: 0 4px 12px rgb(24 24 27 / 8%);
      }

      :global(.dark) :global(.action-button) {
        border-color: #27272a;
        background: #18181b;
        color: #d4d4d8;
      }

      :global(.dark) :global(.action-button:hover) {
        background: #27272a;
      }

      .cli-popover-container {
        position: relative;
        display: inline-flex;
        width: 100%;
      }

      .cli-popover-container .action-button {
        width: 100%;
      }

      .cli-popover {
        position: absolute;
        top: calc(100% + 0.75rem);
        left: 50%;
        z-index: 20;
        width: 20rem;
        max-width: calc(100vw - 2rem);
        padding: 1rem;
        transform: translateX(-50%);
        border: 1px solid #e4e4e7;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 20px 40px rgb(24 24 27 / 16%);
        text-align: left;
      }

      :global(.dark) .cli-popover {
        border-color: #3f3f46;
        background: #18181b;
      }

      .cli-popover[hidden] {
        display: none;
      }

      .cli-popover-title {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
        color: #18181b;
        font-size: 0.875rem;
        font-weight: 600;
      }

      :global(.dark) .cli-popover-title {
        color: #fafafa;
      }

      .cli-popover-title a {
        color: #71717a;
      }

      .cli-command + .cli-command {
        margin-top: 0.75rem;
      }

      .cli-command-label {
        margin: 0 0 0.25rem;
        color: #52525b;
        font-size: 0.75rem;
        font-weight: 500;
      }

      :global(.dark) .cli-command-label {
        color: #a1a1aa;
      }

      .cli-command-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
        background: #f4f4f5;
      }

      :global(.dark) .cli-command-row {
        background: #27272a;
      }

      .cli-command-row code {
        min-width: 0;
        flex: 1;
        overflow-x: auto;
        color: #27272a;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.75rem;
      }

      :global(.dark) .cli-command-row code {
        color: #e4e4e7;
      }

      .copy-button {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        width: 1.5rem;
        height: 1.5rem;
        padding: 0;
        border: 0;
        border-radius: 0.375rem;
        background: transparent;
        color: #71717a;
        cursor: pointer;
      }

      .copy-button:hover {
        color: #18181b;
      }

      :global(.dark) .copy-button:hover {
        color: #fafafa;
      }

      @keyframes dawn-pulse {
        0% { opacity: 0.7; transform: scale(0.96) translateY(-2%); }
        50% { opacity: 1; transform: scale(1.08) translateY(2%); }
        100% { opacity: 0.82; transform: scale(1.01) translateY(0); }
      }

      @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @media (min-width: 640px) {
        .actions {
          width: auto;
          flex-direction: row;
        }

        .cli-popover-container {
          width: auto;
        }

        .cli-popover-container .action-button {
          width: auto;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation: none !important;
          scroll-behavior: auto !important;
          transition-duration: 0ms !important;
        }
      }
    </style>
    <div class="page-shell">
      <div class="dawn-glow" aria-hidden="true"></div>

      <main class="hero">
        <div class="beta-badge">
          <span class="status-dot" aria-hidden="true"></span>
          Markdawn is now in public beta
        </div>

        <h1>Welcome to Markdawn</h1>

        <p class="hero-copy">{PRODUCT_SUMMARY}</p>

        <div class="actions">
      <AppLink class="action-button">Web</AppLink>

          <div class="cli-popover-container" data-cli-popover-container>
            <a
              class="action-button"
              href={CLI_GUIDE}
              target="_blank"
              rel="noopener noreferrer"
              aria-haspopup="dialog"
              aria-expanded="false"
              data-cli-trigger
            >CLI</a>

            <div class="cli-popover" role="dialog" aria-label="Install the CLI" hidden data-cli-popover>
              <div class="cli-popover-title">
                <span>Install the CLI</span>
                <a
                  href={CLI_GUIDE}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open CLI Documentation"
                  title="Open CLI Documentation"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  </svg>
                </a>
              </div>

              {INSTALL_COMMANDS.map(({ label, command, ariaLabel }) => (
                <div class="cli-command">
                  <p class="cli-command-label">{label}</p>
                  <div class="cli-command-row">
                    <code>{command}</code>
                    <button class="copy-button" type="button" data-copy-command={command} aria-label={ariaLabel} title="Copy command">
                      <svg data-copy-icon width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                      </svg>
                      <svg data-copied-icon style="display: none" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m5 12 4 4L19 6"></path>
                      </svg>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <a class="action-button" href={MCP_GUIDE} target="_blank" rel="noopener noreferrer">MCP</a>

        </div>
      </main>
    </div>

    <script>
      const cliContainer = document.querySelector<HTMLElement>('[data-cli-popover-container]');
      const cliTrigger = document.querySelector<HTMLAnchorElement>('[data-cli-trigger]');
      const cliPopover = document.querySelector<HTMLElement>('[data-cli-popover]');
      let hidePopoverTimeout: number | undefined;

      function showPopover() {
        window.clearTimeout(hidePopoverTimeout);
        if (!cliPopover || !cliTrigger) return;
        cliPopover.hidden = false;
        cliTrigger.setAttribute('aria-expanded', 'true');
      }

      function hidePopover() {
        if (!cliPopover || !cliTrigger) return;
        cliPopover.hidden = true;
        cliTrigger.setAttribute('aria-expanded', 'false');
      }

      function schedulePopoverHide() {
        hidePopoverTimeout = window.setTimeout(hidePopover, 150);
      }

      cliContainer?.addEventListener('mouseenter', showPopover);
      cliContainer?.addEventListener('mouseleave', schedulePopoverHide);
      cliContainer?.addEventListener('focusin', showPopover);
      cliContainer?.addEventListener('focusout', (event) => {
        if (!(event.relatedTarget instanceof Node) || !cliContainer.contains(event.relatedTarget)) schedulePopoverHide();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') hidePopover();
      });

      document.querySelectorAll<HTMLButtonElement>('[data-copy-command]').forEach((button) => {
        const copyIcon = button.querySelector<SVGElement>('[data-copy-icon]');
        const copiedIcon = button.querySelector<SVGElement>('[data-copied-icon]');

        const setCopyState = (copied: boolean) => {
          if (copyIcon) copyIcon.style.display = copied ? 'none' : '';
          if (copiedIcon) copiedIcon.style.display = copied ? '' : 'none';
        };

        button.addEventListener('click', async () => {
          const command = button.getAttribute('data-copy-command');
          if (!command) return;
          try {
            await navigator.clipboard.writeText(command);
            setCopyState(true);
            button.setAttribute('aria-label', 'Command copied');
            window.setTimeout(() => {
              setCopyState(false);
              button.setAttribute('aria-label', 'Copy command');
            }, 2000);
          } catch {
            setCopyState(false);
            button.setAttribute('aria-label', 'Copy failed; select the command manually');
            button.setAttribute('title', 'Copy failed; select the command manually');
          }
        });
      });
    </script>
</SiteLayout>
