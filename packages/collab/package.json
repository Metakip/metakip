{
  "name": "@metakip/collab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include 'src/**/*.ts' --conditions=development src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --tsconfig tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hocuspocus/server": "4.6.0",
    "@logtape/logtape": "^2.0.5",
    "@metakip/shared": "workspace:*",
    "better-auth": "^1.7.2",
    "dotenv": "^17.3.1",
    "pg": "^8.18.0",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.6.0",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.1.5",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5",
    "ws": "^8.19.0"
  }
}
