{
  "name": "@metakip/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --include 'src/**/*.ts' --conditions=development src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --tsconfig tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:bench": "vitest bench",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && vitest run --project unit src/db/migration-history.unit.test.ts",
    "db:push": "echo 'db:push is disabled. Generate a migration and run db:migrate instead.' && exit 1",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate-editor-content": "tsx --conditions=development src/scripts/migrateMilkdownDocuments.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/core": "^1.7.2",
    "@better-auth/cimd": "1.7.2",
    "@better-auth/mcp": "^1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@hono/node-server": "^1.19.9",
    "@logtape/hono": "^2.0.5",
    "@logtape/logtape": "^2.0.5",
    "@metakip/shared": "workspace:*",
    "better-auth": "^1.7.2",
    "better-call": "1.4.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.12.0",
    "jszip": "^3.10.1",
    "marked": "^15.0.0",
    "pg": "^8.18.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "yjs": "^13.6.29",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "1.0.0-rc.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0"
  }
}
